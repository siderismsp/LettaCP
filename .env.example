# ── Authentication ────────────────────────────────────────────────────────
# Set this to enable password protection on the whole dashboard (login page).
# Leave empty to disable auth.
DASHBOARD_PASSWORD=

# ── Letta App Server connection ───────────────────────────────────────────
# Default backend the dashboard proxies to (can be overridden at runtime
# from the Settings page).
LETTA_APP_SERVER_URL=http://localhost:8283
# Build-time default used by the client when no runtime override is set.
NEXT_PUBLIC_DEFAULT_LETTA_URL=http://localhost:8283
# Token used for the App Server WebSocket handshake. REQUIRED — set this to
# the same auth token your Letta App Server expects.
LETTA_AUTH_TOKEN=your-letta-auth-token
LETTA_REQUEST_TIMEOUT_MS=120000

# ── Ollama (model dropdown) ────────────────────────────────────────────────
# Optional fallback for the Ollama base URL (overridden by the Settings page / localStorage)
OLLAMA_BASE_URL=http://localhost:11434

# ── Default embedding provider ─────────────────────────────────────────────
# Optional build-time defaults (overridden by the Settings page / localStorage)
NEXT_PUBLIC_DEFAULT_EMBEDDING_MODEL=nomic-embed-text
NEXT_PUBLIC_DEFAULT_EMBEDDING_ENDPOINT=

# ── Webhooks ───────────────────────────────────────────────────────────────
# Shared secret for POST /api/webhooks/sync (set this for webhook auth)
WEBHOOK_SECRET=change-me
